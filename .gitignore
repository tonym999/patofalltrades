# Playwright artifacts
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/

# OS
.DS_Store
Thumbs.db

# Node/Next.js (any subfolder like web/)
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
**/.vercel/
**/coverage/
**/.eslintcache

# Package managers
**/npm-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.pnpm-store/

# Env files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Editors/IDE
.vscode/
.idea/
*.swp

# Misc
**/logs/
**/*.log

# Local agent overrides
# Repo-defined skills under .claude/skills/ are tracked and shared; local settings and
# personal skills are not.
.claude/*
!.claude/skills/
.claude/skills/svg-logo-designer.md
prompts/local/**

# Cursor was retired on 2026-08-23 and its config removed from this repo.
# These entries remain only so stale local files in an older clone cannot be
# committed by accident. Remove them once no working copy has Cursor files left.
.cursor/
.cursorrules
.cursorrules.local
.cursorignore
